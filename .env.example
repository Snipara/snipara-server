# Database
DATABASE_URL="postgresql://snipara:snipara-dev-password@localhost:5433/snipara"

# Redis (local cache, rate limiting, transient coordination)
REDIS_URL="redis://localhost:6380"

# Local operator authentication. Generate a long random value and keep it out
# of Git. This key is sent as X-API-Key by the MCP client.
SNIPARA_LOCAL_API_KEY="replace-with-a-long-random-local-key"
USAGE_TRACKING_ENABLED=false

# Server
HOST="0.0.0.0"
PORT=8000
DEBUG=false
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60
